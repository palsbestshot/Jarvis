# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# PC Agent sensitive files
pc_agent/.env
pc_agent/firebase-service-account.json
pc_agent/gmail-credentials.json
pc_agent/gmail-credentials_token.json
pc_agent/__pycache__/
pc_agent/*.pyc

# Firebase Functions secrets
functions/.env
functions/.env.local
functions/node_modules/

# Flutter app bundled API keys (OpenAI + Anthropic) — DO NOT commit.
# Pallav's APK bundles this at build time; Rakhi's web build uses
# env.web.json (INGEST_SECRET only). Neither belongs on GitHub.
env.json
env.web.json

# Android release signing (kept local only)
android/app/key.properties
android/app/*.jks
android/app/*.keystore

# Build outputs (APK, web, iOS) — regenerated per build
build/
android/app/build/
functions/lib/

# IDE caches
.idea/
*.iml

# Claude Code session state + plans
.claude/
.firebase/
